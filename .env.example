# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会被提交。
# 本仓库是公开仓库，任何密钥都只能放在这里，绝不能写进代码。

# 阿里云 DashScope / 通义千问 VL 的 API Key
# 用于 module2_model/qwen_recognizer.py 与 module6_normalize/i18n_enricher.py
# 未设置时识别功能不可用，但不影响其余模块
DASHSCOPE_API_KEY=

# Flask session cookie 签名密钥
# 一旦泄露，攻击者可伪造 session 绕过登录直接拿到管理员身份
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 未设置时程序会每次启动随机生成（代价：重启后已登录状态失效）
FLASK_SECRET_KEY=

# 管理后台登录密码
# 未设置时 /admin 登录一律拒绝，不会退化成空密码放行
ADMIN_PASSWORD=
